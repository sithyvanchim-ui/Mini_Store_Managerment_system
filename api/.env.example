APP_NAME=MiniStore API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Local default (zero setup). For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://ministore:ministore@localhost:5432/ministore
DATABASE_URL=sqlite+aiosqlite:///./ministore.db

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
